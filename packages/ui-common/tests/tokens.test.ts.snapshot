exports[`tokenCss is the CSS the web and the desktop pages load 1`] = `
":root {\\n  --gx-page-phone: #000000;\\n  --gx-page-wide: #0c0c0e;\\n  --gx-text-phone: #ffffff;\\n  --gx-text-wide: #ededef;\\n  --gx-muted: #a1a1aa;\\n  --gx-faint: #71717a;\\n  --gx-danger: #ff453a;\\n  --gx-success: #30d158;\\n  --gx-success-fill: #248a3d;\\n  --gx-warning: #ffd60a;\\n  --gx-surface: #0b0b0d;\\n  --gx-overlay: #18181b;\\n  --gx-graphite: #1e1e22;\\n  --gx-hover: #28282d;\\n  --gx-tertiary: #27272a;\\n  --gx-separator: #1c1c20;\\n  --gx-edge: #1f1f24;\\n  --gx-border: rgba(255,255,255,0.1);\\n  --gx-hairline: rgba(255,255,255,0.12);\\n  --gx-field-line: rgba(255,255,255,0.32);\\n  --gx-placeholder: rgba(255,255,255,0.3);\\n  --gx-outline: rgba(255,255,255,0.3);\\n  --gx-control: rgba(255,255,255,0.4);\\n  --gx-tick: rgba(255,255,255,0.13);\\n  --gx-tick-on: #f2f2f4;\\n  --gx-button: #f2f2f4;\\n  --gx-button-hover: #ffffff;\\n  --gx-button-ink: #0c0c0e;\\n  --gx-game-city: rgba(255,255,255,0.12);\\n  --gx-game-dirt: rgba(255,255,255,0.3);\\n  --gx-game-ground: rgba(255,255,255,0.5);\\n  --gx-here: #93e06b;\\n  --gx-here-ink: #0b2a00;\\n  --gx-others: #e4a0ea;\\n  --gx-others-ink: #1a0a1c;\\n  --gx-font: \\"Onest Variable\\", \\"Onest\\", -apple-system, BlinkMacSystemFont, \\"Segoe UI\\", system-ui, sans-serif;\\n  --gx-title-size: 34px;\\n  --gx-title-line: 40px;\\n  --gx-title-tracking: -0.8px;\\n  --gx-sub-size: 17px;\\n  --gx-sub-line: 23px;\\n  --gx-field-size: 22px;\\n  --gx-field-line-height: 28px;\\n  --gx-choice-size: 20px;\\n  --gx-choice-line: 26px;\\n  --gx-label-size: 14px;\\n  --gx-label-line: 18px;\\n  --gx-note-size: 15px;\\n  --gx-note-line: 20px;\\n  --gx-stage-size: 15px;\\n  --gx-stage-line: 20px;\\n  --gx-key-size: 24px;\\n  --gx-key-line: 32px;\\n  --gx-key-tracking: 1px;\\n  --gx-kept-size: 18px;\\n  --gx-drum-size: 19px;\\n  --gx-drum-tracking: -0.2px;\\n  --gx-button-size: 17px;\\n  --gx-in-block: 8px;\\n  --gx-between: 32px;\\n  --gx-section: 48px;\\n  --gx-column: 480px;\\n  --gx-radius-button: 24px;\\n  --gx-radius-field: 12px;\\n  --gx-radius-popover: 24px;\\n  --gx-page: var(--gx-page-phone);\\n  --gx-text: var(--gx-text-phone);\\n}\\n@media (min-width: 821px) {\\n  :root {\\n    --gx-page: var(--gx-page-wide);\\n    --gx-text: var(--gx-text-wide);\\n  }\\n}"
`;
