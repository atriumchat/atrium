{
  "name": "gomex-desktop",
  "productName": "Gomex",
  "version": "1.3.0",
  "description": "Gomex для компьютера: чат и звонки, которые приходят, даже когда окно закрыто",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "GOMEX_URL=http://localhost:5180 electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.gomex-inc.gomex",
    "productName": "Gomex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "address.html",
      "address.js",
      "address-preload.js",
      "assets/**",
      "ptt.js",
      "update-key.pem"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gomex использует микрофон для звонков.",
        "NSCameraUsageDescription": "Gomex использует камеру для видеозвонков."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Gomex"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Gomex"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
