{
  "name": "gomex-desktop",
  "productName": "Gomex",
  "version": "1.5.0",
  "description": "Gomex for desktop: chat and calls that arrive even when the window is closed",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "GOMEX_URL=http://localhost:5180 electron .",
    "check:i18n": "node check-i18n.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.gomex-inc.gomex",
    "productName": "Gomex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "i18n.js",
      "i18n-page.js",
      "preload.js",
      "updater.js",
      "address.html",
      "address.js",
      "address-preload.js",
      "onboarding.html",
      "onboarding.css",
      "onboarding.js",
      "onboarding-preload.js",
      "server-setup.js",
      "screen-picker.js",
      "picker.html",
      "picker.css",
      "picker.js",
      "picker-preload.js",
      "reachable.js",
      "unreachable.html",
      "unreachable.js",
      "unreachable-preload.js",
      "assets/**",
      "ptt.js",
      "update-key.pem",
      "!node_modules/uiohook-napi/build/**",
      "!node_modules/uiohook-napi/prebuilds/linux-*/**",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gomex uses the microphone for calls.",
        "NSCameraUsageDescription": "Gomex uses the camera for video calls."
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Gomex"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Gomex"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "uiohook-napi": "^1.5.5"
  }
}
